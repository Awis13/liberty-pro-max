# Lifter manifest: GTAIV.exe 1.0.8.0
# (SHA-256 3d90e7c516fa450ca002e5031e62c0f66b404590f33e6cc9793b0da4fffbfd0f).
# Line based, guest VAs in hex (see x86recomp tools/lifter/main.cpp):
#   entry <va> [name] | name <va> <name> | probe <va> [name]
#   resume <va> | setjmp <va> [name] | replace <va> [name] | hook <va> <end>

# Function entries Ghidra did not find (reached by indirect branches): the
# CRT's x87 exp/sin/cos/tan dispatch handlers, listed (unaligned) in the
# records at .data F63780..F63860.
entry 00D03451
entry 00D03591
entry 00D0374C
entry 00D0375D
entry 00D03762
entry 00D04110
entry 00D04129
entry 00D04162
entry 00D04184
entry 00D04191
entry 00D041B1

# The PAUL copy-protection layer (src/paul.cpp): its wrappers run code the
# game builds at start, so they are replaced by what they stand for.
replace 00D18223 Paul_Init
replace 00D176A0 Paul_Load
replace 00D16A9F Paul_CommandLine
replace 00D17BFF Paul_CheckFile
replace 00D17BD7 Paul_CheckFile2
replace 00D17CD3 Paul_CreateFileA
replace 00D17E6B Paul_CloseHandle
replace 00D17E92 Paul_SetFilePointer
replace 00D17D38 Paul_ReadFile
replace 00D17EBA Paul_GetFileSize

# Start-up integrity checks (src/integrity.cpp).
replace 004906B0 VerifySigner
replace 0048F900 CheckLauncher
hook 0048FF22 004900DE   # launcher image hash check (EFC2x)
replace 00D49410 launcher_state      # the launcher's shared state: its window and message
replace 00B4FAA0 launcher_seq_a      # the launcher's sequence checks: passed
replace 00B4FAC0 launcher_seq_b
replace 00B4FAD0 launcher_seq_c
replace 00B4FB00 launcher_seq_d

# Aspect ratio (src/widescreen.cpp, from FusionFix's widescreenfix).
hook 0089BA65 0089BAC2   # auto aspect: from the active resolution
hook 004A158D 004A158F   # push 1 -> push 0
hook 00492428 00492430   # cellphone width
hook 00D44C99 00D44CA1   # frontend width
hook 004A1729 004A172E   # loading-screen art: 16:9, centred, pillars
hook 004A179E 004A17A3
hook 004A1840 004A1845
hook 004B1248 004B1250   # pause map: the screen's aspect
hook 008739AC 008739B3   # pause map: tile columns for the width
hook 00870B0E 00870B14   # pause map: round area blips
hook 00486DDC 00486DE2   # pause map crosshair: thickness
hook 00486E0D 00486E13
hook 00486E9E 00486EA6   # pause map crosshair: fade

# Diagnostics (src/diagnostics.cpp).
replace 00454860 SimpleAllocator_Allocate


replace 007BDD80 Frontend_SetState

# The CRT's memmove and SSE2 math, run as the host's (src/crt_math.cpp).
replace 00CF52B0 crt_memmove
replace 00CF59F9 crt_cos
replace 00CF5841 crt_sin
replace 00CF99C0 crt_atan2
replace 00CF6861 crt_pow
replace 00CF7456 crt_acos
replace 00CF7930 crt_tan

# Benchmark scene (src/bench.cpp): runs after the main loop's render wait.
replace 008A1860 MainLoop_WaitRender

# GTAIV_PERF counters (src/perf.cpp): the frame handoff, job waits, polls
# and thread starts.
replace 004563D0 sysIpcWaitSema
replace 004563B0 sysIpcPollSema
replace 00456610 sysIpcSleep
replace 00964B90 Rmptfx_WaitUpdate
replace 007BBCD0 Audio_WaitUpdate
replace 00863B50 RenderThread_RunFrame
replace 00460D50 Jobs_Wait
replace 00456500 sysIpcCreateThread
replace 00456460 sysIpcThreadStart

# Fixes of the game's own bugs (src/fixes.cpp).
replace 008CC970 Pool_SweepAtShutdown   # quit before the world loaded: no streaming table
replace 0094A6D0 PedIntelligence_DecreasePinnedDown   # above 30 fps it never decreased: cops stuck in cover
replace 008936A0 RadioHud_LogoBw      # a logo dictionary without the logo: the logo found stays
replace 00893680 RadioHud_LogoColour  # the same
replace 00893870 RadioHud_Find       # a station without a radiohud.dat line: an empty record, not null (issue 15)
replace 00893920 RadioHud_DrawLogo   # and no logo drawn for it
replace 00896310 RadioHud_DrawWheelLogo  # the same, in the wheel (its fade still steps)
replace 00B564A0 RadioHud_DrawMenuLogo   # the same, the menus' deferred logo
hook 00895F59 00895F5E   # radio listening time: stations past the stats' 20 slots not counted (the save grew to hundreds of MB)
# Millisecond clocks and script timers keep their fractions (src/fixes.cpp).
hook 007CC06F 007CC075   # CTimer: the game's clock
hook 007CC1BB 007CC1C1   # CTimer: a second clock
hook 007CC33E 007CC344   # CTimer: a third clock (the screen fades')
hook 00625414 0062541D   # scrThread::Update: TIMERA, TIMERB, WAIT
replace 0094AC20 PedIntelligence_ProcessStaticCounter   # 30 Hz: tasks gave up early above 30 fps
hook 00A53E4E 00A53E56   # drunk steering bias, cars: per time
hook 00B9A94F 00B9A957   # drunk steering bias, bikes: per time
replace 00A7C8E0 CamFollowVehicle_ProcessHandBrakeSwing   # per time: the camera spun round the car in handbrake turns
hook 00A810F4 00A810FC   # vehicle camera auto-centring: no per-frame clamp (x)
hook 00A813DC 00A813E9   # vehicle camera auto-centring: no per-frame clamp (y)
hook 00A9C466 00A9C46E   # aim zoom smoothing, weapons: per time
hook 00A98D7B 00A98D83   # aim zoom smoothing, melee: per time
hook 004AF577 004AF57C   # chase blips' flashing: 30 Hz
hook 008ACE69 008ACE6F   # saving/loading spinner: 30 Hz
hook 009C8239 009C823F   # helicopter blinking lights: 30 Hz
hook 00AB8DB7 00AB8DB9   # downwash wind particles: per second
hook 00AF1FCC 00AF1FCE   # boat wake ripples: per second
hook 00B91371 00B91373   # swim splash ripples: per second
replace 009AE2C0 Water_AddToDynamicWaterSpeed   # per time
replace 009AE360 Water_ModifyDynamicWaterSpeed  # per time
hook 009CB59C 009CB5A4   # helicopter main rotor speed: per time
hook 009CB5DA 009CB5E2   # helicopter tail rotor speed: per time
# Conveniences (src/options.cpp).
hook 0047D255 0047D257   # the first menu: GTAIV_CONTINUE starts in the newest save (the chooser first with none)
replace 0085A520 Saves_ReadEpisodeArg   # with the episodes off, a start is given -episode 0: IV's newest save
replace 00859070 Saves_NewestSlotOfGame # with an episode's folder missing, the newest save of a game that is there
replace 004944E0 Frontend_StartGame     # and that is taken back once the start is over
hook 004A346B 004A3475   # start screens' times: GTAIV_SKIP_INTRO skips the short ones
replace 00A777C0 CamGame_PostProcessHeightBasedFOV   # GTAIV_FOV: wider field of view
hook 00401854 00401859   # startup sleep 5000 ms: none with GTAIV_FAST_LOADING (default)
hook 004F2036 004F203D   # physics pair list: main takes pairs too before waiting (GTAIV_PHYSICS_HELP)
hook 00855D82 00855D8C   # gtaDefSched worker mask: GTAIV_JOB_WORKERS workers (game: 3)
hook 0079BADB 0079BAE2   # audio engine buffer wait: a 250 us sleep, not Sleep(0) (GTAIV_AUDIO_SPIN)
hook 006D4F92 006D4F97   # population removal: due-record allowance 20 (GTAIV_DESPAWN_NEED; game: 5)
hook 00C8DB86 00C8DB8C   # melee: self ready to be stunned (GTAIV_STUN_PUNCH)
hook 00C8DBAB 00C8DBB1   # melee: opponent ready to be stunned (GTAIV_STUN_PUNCH)
hook 00C8DBD0 00C8DBD6   # melee: self ready to be executed (GTAIV_EXECUTIONS)
hook 00C8DBF5 00C8DBFB   # melee: opponent ready to be executed (GTAIV_EXECUTIONS)
replace 00922630         # physics job count: GTAIV_JOB_WORKERS (game: 3)

