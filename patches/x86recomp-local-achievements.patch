+                    mipmapLevel:0
+                      withBytes:bm.rgba
+                    bytesPerRow:NSUInteger(bm.width * 4)];
+      toast_serial_ = bm.serial;
+    }
+    DrawAlphaQuad(e, toast_tex_, float(pw), float(ph), Rect{bm.x, bm.y, bm.x + bm.width, bm.y + bm.height});
+  }
